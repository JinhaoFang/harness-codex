#!/usr/bin/env python3
import re
import sys
from pathlib import Path

ALLOWED_PREFIXES = ("feat", "fix", "refactor", "docs", "test", "chore", "build", "ci", "perf", "revert")
CONVENTIONAL_RE = re.compile(rf"^(?:{'|'.join(ALLOWED_PREFIXES)})(?:\([^)]+\))?: .+")


def main() -> int:
    if len(sys.argv) != 2:
        sys.stderr.write("usage: commit-msg <path-to-commit-message>\n")
        return 2

    message_path = Path(sys.argv[1])
    if not message_path.exists():
        sys.stderr.write(f"commit message file not found: {message_path}\n")
        return 2

    lines = message_path.read_text(encoding="utf-8").splitlines()
    subject = next((line.strip() for line in lines if line.strip()), "")
    if not subject:
        sys.stderr.write("❌ commit-msg: commit subject must not be empty\n")
        return 1

    allowed_special = (
        subject.startswith("Merge "),
        subject.startswith("Revert "),
        subject.startswith("fixup! "),
        subject.startswith("squash! "),
        subject.startswith("TDD: "),
    )
    if not any(allowed_special) and not CONVENTIONAL_RE.match(subject):
        sys.stderr.write("❌ commit-msg: subject must use Conventional Commit form or `TDD: ...`\n")
        sys.stderr.write("   examples: `feat: add login callback`, `fix(auth): reject expired token`, `TDD: cover retry path`\n")
        return 1

    if len(subject) > 72 and not subject.startswith("Merge "):
        sys.stderr.write("❌ commit-msg: subject should be 72 characters or fewer\n")
        return 1

    if subject.endswith("."):
        sys.stderr.write("❌ commit-msg: subject should not end with a period\n")
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
