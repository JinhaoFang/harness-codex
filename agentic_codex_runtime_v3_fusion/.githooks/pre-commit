#!/usr/bin/env python3
import re
import subprocess
import sys
from pathlib import Path

SECRET_PATTERNS = [
    r'(?i)(api[_-]?key|apikey)\s*[=:]\s*["\'][^"\']{8,}["\']',
    r'(?i)(password|passwd|pwd)\s*[=:]\s*["\'][^"\']{4,}["\']',
    r'(?i)(secret[_-]?key)\s*[=:]\s*["\'][^"\']{8,}["\']',
    r'\bsk-[A-Za-z0-9]{20,}\b',
    r'\bghp_[A-Za-z0-9]{20,}\b',
]

DANGEROUS_PATTERNS = [
    r'(?i)\brm\s+-rf\s+/\b',
    r'(?i)\bmkfs\b',
    r'(?i)\bdd\s+if=',
    r'(?i)>\s*/dev/sd',
    r'(?i)\bchmod\s+777\b',
    r'(?i)\bcurl\b.*\|\s*(bash|sh)\b',
    r'(?i)\bwget\b.*\|\s*(bash|sh)\b',
]

TEXT_EXTS = {".sh", ".py", ".js", ".ts", ".tsx", ".jsx", ".md", ".yml", ".yaml", ".toml", ".json"}


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, capture_output=True, text=True)


def staged_files() -> list[str]:
    r = run(["git", "diff", "--cached", "--name-only"])
    if r.returncode != 0:
        return []
    return [p for p in r.stdout.splitlines() if p.strip()]


def is_text_candidate(path: str) -> bool:
    p = Path(path)
    if p.suffix in TEXT_EXTS:
        return True
    return False


def scan_added_lines(path: str) -> tuple[bool, str]:
    r = run(["git", "diff", "--cached", "--", path])
    if r.returncode != 0:
        return True, ""
    for raw in r.stdout.splitlines():
        if not raw.startswith("+") or raw.startswith("+++"):
            continue
        line = raw[1:]
        for pat in SECRET_PATTERNS:
            if re.search(pat, line):
                return False, f"❌ 检测到潜在密钥泄露：{path}\n   {line.strip()[:160]}"
        if is_text_candidate(path):
            for pat in DANGEROUS_PATTERNS:
                if re.search(pat, line):
                    return False, f"⚠️  检测到危险命令：{path}\n   {line.strip()[:160]}"
    return True, ""


def main() -> int:
    print("🔍 pre-commit: secrets / dangerous commands")
    files = staged_files()
    for f in files:
        ok, msg = scan_added_lines(f)
        if not ok:
            print(msg)
            print("\n提示：修复后重新 commit；`--no-verify` 可跳过（不推荐，CI 仍会拦）。")
            return 1
    print("✅ pre-commit 检查通过")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

