#!/usr/bin/env python3
import sys

PROTECTED = {"refs/heads/main", "refs/heads/master"}


def main() -> int:
    # stdin lines: <local ref> <local sha> <remote ref> <remote sha>
    blocked = []
    for ln in sys.stdin.read().splitlines():
        parts = ln.strip().split()
        if len(parts) != 4:
            continue
        _, _, remote_ref, _ = parts
        if remote_ref in PROTECTED:
            blocked.append(remote_ref)
    if blocked:
        refs = ", ".join(sorted(set(blocked)))
        sys.stderr.write(f"❌ pre-push: 禁止直接 push 到受保护分支：{refs}\n")
        sys.stderr.write("请通过 PR 合并（或显式调整钩子规则）。\n")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

