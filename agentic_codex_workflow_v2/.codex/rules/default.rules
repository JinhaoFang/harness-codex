# Project rules for sandbox escapes and risky commands.
# See: codex execpolicy check --pretty --rules .codex/rules/default.rules -- <command>

# GitHub read actions: prompt before each run.
prefix_rule(
    pattern = ["gh", "issue", ["view", "list"]],
    decision = "prompt",
    justification = "Issue inspection is allowed with approval.",
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "list"]],
    decision = "prompt",
    justification = "PR inspection is allowed with approval.",
)

# GitHub write actions: always prompt.
prefix_rule(
    pattern = ["gh", "issue", ["create", "edit", "comment", "close", "reopen"]],
    decision = "prompt",
    justification = "Issue mutation affects external state and should always be reviewed.",
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "edit", "comment", "merge", "close", "reopen"]],
    decision = "prompt",
    justification = "PR mutation affects external state and should always be reviewed.",
)

# Allow safe local inspection helpers outside the sandbox if needed.
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "Read-only git inspection is safe.",
)

# Potentially destructive local mutations: prompt.
prefix_rule(
    pattern = ["git", ["add", "commit", "restore", "reset", "checkout", "switch", "clean", "stash"]],
    decision = "prompt",
    justification = "Git mutations should be intentional and reviewable.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes is an external side effect and must be explicitly approved.",
)


# Worktree mutations: prompt.
prefix_rule(
    pattern = ["git", "worktree", ["add", "remove", "move", "prune", "lock", "unlock"]],
    decision = "prompt",
    justification = "Worktree mutations change workspace topology and should be intentional.",
)

# Network/package installs: prompt.
prefix_rule(
    pattern = [["npm", "pnpm", "yarn", "uv", "pip", "pip3"], ["install", "add", "sync"]],
    decision = "prompt",
    justification = "Dependency or environment changes can alter the project state and should be approved.",
)

# Dangerous filesystem commands: forbid.
prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r", "-f"]],
    decision = "forbidden",
    justification = "Destructive deletes are blocked. Use safer, narrower file operations instead.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Privilege escalation is not allowed from this project workflow.",
)
