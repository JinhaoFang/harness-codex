{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Execution Plan",
  "type": "object",
  "required": [
    "schema_version",
    "work_unit_id",
    "title",
    "repository_grounding",
    "architecture_and_tradeoffs",
    "change_map",
    "behavior_slices",
    "acceptance_evidence",
    "verification_notes",
    "risks_and_replan_conditions",
    "reviewer_focus"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.execution_plan.v2"
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "repository_grounding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "architecture_and_tradeoffs": {
      "type": "string",
      "minLength": 1
    },
    "change_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "change",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "behavior_slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim_ref",
          "behavior",
          "test_paths",
          "oracle",
          "red",
          "green",
          "allowed_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim_ref": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "test_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "red": {
            "type": "object",
            "required": [
              "check_id",
              "expected_failure"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "expected_failure": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "exit_codes": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "stdout_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stderr_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "combined_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stdout_regex": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stderr_regex": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "combined_regex": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "green": {
            "type": "object",
            "required": [
              "check_id"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_ref",
          "check_id",
          "level",
          "justification"
        ],
        "properties": {
          "claim_ref": {
            "type": "string",
            "minLength": 1
          },
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "unit",
              "integration",
              "functional",
              "e2e",
              "acceptance",
              "smoke",
              "build",
              "lint",
              "typecheck",
              "runtime"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "verification_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks_and_replan_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_focus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
