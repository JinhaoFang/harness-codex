{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Waiver",
  "type": "object",
  "required": [
    "schema_version",
    "waiver_id",
    "work_unit_id",
    "waiver_type",
    "approved_by",
    "reason",
    "waived_requirement",
    "risk_accepted",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.waiver.v1"
    },
    "waiver_id": {
      "type": "string"
    },
    "work_unit_id": {
      "type": "string"
    },
    "waiver_type": {
      "enum": [
        "evidence",
        "risk",
        "scope",
        "deadline"
      ]
    },
    "requested_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "waived_requirement": {
      "type": "string"
    },
    "replacement_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_accepted": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  }
}
