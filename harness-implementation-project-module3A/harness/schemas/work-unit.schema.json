{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Work Unit State",
  "type": "object",
  "required": [
    "schema_version",
    "work_unit_id",
    "status",
    "risk",
    "generation",
    "spec_path",
    "plan_path",
    "base_commit",
    "bound_repository_identity",
    "bound_workspace_id",
    "bound_worktree",
    "bound_branch",
    "repository_id",
    "workspace_id",
    "worktree",
    "branch",
    "head_commit",
    "changed_files",
    "implementation_changed_files",
    "diff_hash",
    "implementation_diff_hash",
    "latest_evidence_refs",
    "known_failures",
    "blockers",
    "next_safe_action",
    "rollback_or_reopen_path",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.work_unit_state.v3"
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "clarifying",
        "spec_approved",
        "planning",
        "plan_reviewing",
        "ready",
        "running",
        "verifying",
        "reviewing",
        "handoff",
        "archived",
        "blocked"
      ]
    },
    "risk": {
      "enum": [
        "trivial",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "spec_path": {
      "type": "string",
      "minLength": 1
    },
    "plan_path": {
      "type": "string",
      "minLength": 1
    },
    "spec_approved_hash": {
      "type": "string"
    },
    "spec_approved_at": {
      "type": "string"
    },
    "spec_approved_by": {
      "type": "string"
    },
    "spec_approval_ref": {
      "type": "string"
    },
    "plan_approved_hash": {
      "type": "string"
    },
    "review_track_id": {
      "type": "string"
    },
    "logical_reviewer_session_id": {
      "type": "string"
    },
    "builder_id": {
      "type": "string"
    },
    "builder_session_id": {
      "type": "string"
    },
    "current_role": {
      "type": "string"
    },
    "base_commit": {
      "type": "string"
    },
    "bound_repository_identity": {
      "type": "string",
      "minLength": 1
    },
    "bound_workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "bound_worktree": {
      "type": "string",
      "minLength": 1
    },
    "bound_branch": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "head_commit": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diff_hash": {
      "type": "string"
    },
    "implementation_diff_hash": {
      "type": "string"
    },
    "latest_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_safe_action": {
      "type": "string"
    },
    "rollback_or_reopen_path": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
