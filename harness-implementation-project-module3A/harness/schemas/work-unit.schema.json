{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Work Unit State",
  "type": "object",
  "required": [
    "schema_version",
    "work_unit_id",
    "status",
    "risk",
    "spec_path",
    "plan_path",
    "branch",
    "worktree",
    "workspace_id",
    "base_commit",
    "head_commit",
    "changed_files",
    "implementation_changed_files",
    "diff_hash",
    "implementation_diff_hash",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.work_unit_state.v2"
    },
    "work_unit_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "clarifying",
        "spec_approved",
        "planning",
        "plan_reviewing",
        "ready",
        "running",
        "verifying",
        "reviewing",
        "handoff",
        "archived",
        "blocked"
      ]
    },
    "risk": {
      "enum": [
        "trivial",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "spec_path": {
      "type": "string"
    },
    "plan_path": {
      "type": "string"
    },
    "spec_approved_hash": {
      "type": "string"
    },
    "plan_approved_hash": {
      "type": "string"
    },
    "review_track_id": {
      "type": "string"
    },
    "builder_id": {
      "type": "string"
    },
    "builder_session_id": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "base_commit": {
      "type": "string"
    },
    "head_commit": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diff_hash": {
      "type": "string"
    },
    "implementation_diff_hash": {
      "type": "string"
    },
    "latest_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_safe_action": {
      "type": "string"
    },
    "rollback_or_reopen_path": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "planner_id": {
      "type": "string"
    },
    "planner_identity_source": {
      "type": "string"
    },
    "planner_session_id": {
      "type": "string"
    },
    "planner_session_source": {
      "type": "string"
    }
  }
}
