{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Evidence Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "work_unit_id",
    "claim_ref",
    "actor",
    "observation",
    "type",
    "phase",
    "command",
    "argv",
    "expected_outcome",
    "observed_outcome",
    "result",
    "started_at",
    "ended_at",
    "exit_code",
    "base_commit",
    "head_commit",
    "branch",
    "workspace_id",
    "spec_hash",
    "plan_hash",
    "diff_hash",
    "implementation_diff_hash",
    "changed_files",
    "implementation_changed_files",
    "verification_scope",
    "freshness_basis",
    "command_log_ref",
    "command_log_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.evidence_receipt.v3"
    },
    "receipt_id": {
      "type": "string"
    },
    "work_unit_id": {
      "type": "string"
    },
    "claim_ref": {
      "type": "string"
    },
    "actor": {
      "enum": [
        "controller",
        "agent",
        "human",
        "ci"
      ]
    },
    "observation": {
      "enum": [
        "controller_executed_command",
        "skipped_not_evidence"
      ]
    },
    "type": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "red",
        "green",
        "final"
      ]
    },
    "command": {
      "type": "string"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_outcome": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "observed_outcome": {
      "enum": [
        "exit_zero",
        "exit_nonzero",
        "not_run"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "skipped"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "base_commit": {
      "type": "string"
    },
    "head_commit": {
      "type": "string"
    },
    "diff_hash": {
      "type": "string"
    },
    "implementation_diff_hash": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_scope": {
      "type": "string"
    },
    "freshness_basis": {
      "type": "string"
    },
    "command_log_ref": {
      "type": "string"
    },
    "environment_ref": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "command_log_hash": {
      "type": "string"
    },
    "spec_hash": {
      "type": "string"
    },
    "plan_hash": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    }
  }
}
