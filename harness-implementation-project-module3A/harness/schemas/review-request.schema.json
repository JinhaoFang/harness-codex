{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Review Request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "work_unit_id",
    "mode",
    "review_track_id",
    "review_track_generation",
    "reviewer_id",
    "logical_reviewer_session_id",
    "reviewer_session_source",
    "planner_id",
    "planner_session_id",
    "builder_id",
    "builder_session_id",
    "spec_hash",
    "plan_hash",
    "head_commit",
    "implementation_diff_hash",
    "workspace_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.review_request.v4"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "plan",
        "close"
      ]
    },
    "review_track_id": {
      "type": "string",
      "minLength": 1
    },
    "review_track_generation": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_reviewer_session_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_session_source": {
      "type": "string",
      "minLength": 1
    },
    "planner_id": {
      "type": "string"
    },
    "planner_session_id": {
      "type": "string"
    },
    "builder_id": {
      "type": "string"
    },
    "builder_session_id": {
      "type": "string"
    },
    "spec_hash": {
      "type": "string"
    },
    "plan_hash": {
      "type": "string"
    },
    "head_commit": {
      "type": "string"
    },
    "implementation_diff_hash": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
