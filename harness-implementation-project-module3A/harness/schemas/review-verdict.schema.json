{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Review Verdict",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "request_id",
    "review_track_id",
    "work_unit_id",
    "mode",
    "reviewer_id",
    "reviewer_session_id",
    "planner_id",
    "planner_session_id",
    "builder_id",
    "builder_session_id",
    "independence_level",
    "is_independent",
    "decision",
    "approval_ref",
    "reviewed_spec_hash",
    "reviewed_plan_hash",
    "reviewed_implementation_diff_hash",
    "evidence_refs",
    "findings",
    "required_rework",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.review_verdict.v3"
    },
    "review_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "review_track_id": {
      "type": "string"
    },
    "work_unit_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "plan",
        "close"
      ]
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_identity_source": {
      "type": "string"
    },
    "reviewer_session_id": {
      "type": "string"
    },
    "reviewer_session_source": {
      "type": "string"
    },
    "builder_id": {
      "type": "string"
    },
    "builder_session_id": {
      "type": "string"
    },
    "independence_level": {
      "enum": [
        "self_check",
        "separate_role",
        "fresh_context",
        "human_gate"
      ]
    },
    "is_independent": {
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "PASS",
        "CHANGES_REQUESTED",
        "REJECTED",
        "BLOCKED",
        "NEEDS_HUMAN_GATE"
      ]
    },
    "reviewed_spec_hash": {
      "type": "string"
    },
    "reviewed_plan_hash": {
      "type": "string"
    },
    "reviewed_implementation_diff_hash": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_rework": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "approval_ref": {
      "type": "string"
    },
    "planner_id": {
      "type": "string"
    },
    "planner_session_id": {
      "type": "string"
    }
  }
}
