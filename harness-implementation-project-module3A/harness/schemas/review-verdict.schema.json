{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Review Verdict",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "work_unit_id",
    "mode",
    "reviewer_role",
    "builder_role",
    "independence_level",
    "decision",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "harness.review_verdict.v1"
    },
    "review_id": {
      "type": "string"
    },
    "work_unit_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "plan",
        "close",
        "risk",
        "security",
        "architecture",
        "evaluator"
      ]
    },
    "reviewer_role": {
      "type": "string"
    },
    "builder_role": {
      "type": "string"
    },
    "independence_level": {
      "enum": [
        "self_check",
        "separate_role",
        "fresh_context",
        "human_gate"
      ]
    },
    "is_independent": {
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "PASS",
        "PASS_WITH_RISK_ACCEPTED",
        "CHANGES_REQUESTED",
        "REJECTED",
        "BLOCKED",
        "NEEDS_HUMAN_GATE"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_rework": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
