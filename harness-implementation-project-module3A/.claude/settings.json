{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git reset --hard)",
      "Bash(git push --force*)",
      "Bash(git push* main*)",
      "Bash(git push* master*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(terraform apply*)",
      "Bash(pulumi up*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)"
    ],
    "allow": [
      "Bash(harnessctl *)",
      "Bash(./harnessctl *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Read(**)",
      "Grep(**)",
      "Glob(**)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/harness/hooks/context_router.py SubagentStart --platform claude"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/harness/hooks/pre_compact_handoff_check.py"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/harness/hooks/context_router.py PostCompact --platform claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/harness/hooks/session_end_handoff_check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/harness/hooks/pre_tool_use_policy.py --platform claude"
          }
        ]
      }
    ]
  }
}
